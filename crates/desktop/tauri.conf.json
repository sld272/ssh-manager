{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ssh-manager",
  "identifier": "dev.ssh-manager.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ssh-manager",
        "width": 1280,
        "height": 860,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
